# Keep the build context small — everything here is either rebuilt inside
# the image, irrelevant to the build, or must never enter it (secrets).

node_modules
.next
out
build

# Secrets — these are injected as env vars by the platform, never baked in.
.env
.env.*
!.env.example

.git
.github
.vscode
.idea

# Static HTML design prototypes — design source of truth, not shipped.
*.html

# Docs / local tooling
*.md
!README.md
.claude

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# Local dev uploads (prod writes to blob storage, not the filesystem)
public/uploads
